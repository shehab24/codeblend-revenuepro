generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id
  email                 String   @unique
  name                  String?
  phone                 String?
  role                  String   @default("user")
  verified              Boolean  @default(false)
  downloadAllowed       Boolean  @default(true)
  expenseTrackerAllowed Boolean  @default(true)
  bkashTrackerAllowed   Boolean  @default(true)
  revenueProAllowed     Boolean  @default(true)
  whitelistKeywords     String[] @default([])
  expenseBackupUrl      String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // CodePay Gateway Settings
  codepayApiKey         String?  @unique
  codepayApiSecret      String?
  codepayActive         Boolean  @default(true)
  codepayBkash          String?
  codepayNagad          String?
  codepayRocket         String?
  codepayUpay           String?
  codepayCellfin        String?
  codepayTap            String?

  codepayBkashActive    Boolean  @default(true)
  codepayNagadActive    Boolean  @default(true)
  codepayRocketActive   Boolean  @default(true)
  codepayUpayActive     Boolean  @default(true)
  codepayCellfinActive  Boolean  @default(true)
  codepayTapActive      Boolean  @default(true)

  codepayWithTrx        Boolean  @default(true)
  codepayWithoutTrx     Boolean  @default(false)

  // Bank Transfer Settings (Deprecated, use codepayBankAccounts instead)
  codepayBankName       String?
  codepayBankAccountName String?
  codepayBankAccountNo   String?
  codepayBankBranch     String?
  codepayBankActive     Boolean  @default(false)

  // CodePay Merchant Branding
  codepayBrandName      String?
  codepayBrandLogo      String?
  codepayBrandColor     String?  @default("#0f172a")

  codepayBankAccounts   CodePayBankAccount[]

  licenses              License[]
  serviceRequests       ServiceRequest[]
  transactions          PaymentTransaction[]
  bkashSmsTransactions  BkashSmsTransaction[]
  codepayPayments       CodePayPayment[]
  invoices              Invoice[]
}

model CodePayBankAccount {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankName    String   // e.g. "ibl", "abbank", "citybank", "sonali", "dbbl", "basic", "ebl"
  accountName String
  accountNo   String
  branch      String?
  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model License {
  id             String    @id @default(cuid())
  userId         String    // Maps to User.id (Clerk's user ID)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerEmail  String?   // Specifically bound external customer email for WP validation
  key            String    @unique
  domain         String
  tier           String    @default("Standard")
  expirationDate DateTime?
  status         String    @default("active") // active, suspended, revoked
  paymentStatus  String    @default("unpaid") // unpaid, paid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  logs           VerificationLog[]
  fraudStats     FraudStat[]
  transactions   PaymentTransaction[]
}

model VerificationLog {
  id        String   @id @default(cuid())
  licenseId String
  license   License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  status    String   // success, failed
  timestamp DateTime @default(now())
}

model Setting {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}

model FraudStat {
  id                 String   @id @default(cuid())
  licenseId          String?
  license            License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  domain             String?
  phone              String   @unique
  total_parcel       Int      @default(0)
  success_parcel     Int      @default(0)
  cancelled_parcel   Int      @default(0)
  success_ratio      Float    @default(0)
  pathao_success     Int      @default(0)
  pathao_cancel      Int      @default(0)
  steadfast_success  Int      @default(0)
  steadfast_cancel   Int      @default(0)
  parceldex_success  Int      @default(0)
  parceldex_cancel   Int      @default(0)
  redx_success       Int      @default(0)
  redx_cancel        Int      @default(0)
  paperfly_success   Int      @default(0)
  paperfly_cancel    Int      @default(0)
  carrybee_success   Int      @default(0)
  carrybee_cancel    Int      @default(0)
  courier_data       String?
  reports            String?
  last_checked       DateTime @default(now())

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ServiceRequest {
  id          String   @id @default(cuid())
  applicantId     String?
  applicant       User?    @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  contactEmail    String?
  serviceType     String   // e.g. "RevenuePro", "Custom Plugin", "Pro Plan"
  websiteUrl      String?  @db.Text
  message         String?  @db.Text
  status          String   @default("pending") // pending, in_progress, completed, cancelled
  
  // Billing & Delivery
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  deliveryDate    DateTime?

  transactions    PaymentTransaction[]
  notes           RequestNote[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RequestNote {
  id               String         @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  authorRole       String         // "user" | "admin"
  authorName       String?
  message          String         @db.Text
  createdAt        DateTime       @default(now())
}

model PaymentTransaction {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  
  licenseId        String?
  license          License? @relation(fields: [licenseId], references: [id], onDelete: SetNull)
  
  amount           Float
  paymentMethod    String   // "bkash_manual", "bkash_api"
  transactionId    String?  @unique // bKash TrxID
  status           String   @default("pending") // "pending", "completed", "failed", "verified", "rejected"
  senderNumber     String?
  notes            String?  @db.Text
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BkashSmsTransaction {
  id            String   @id @default(cuid())
  userId        String   // Links to the merchant who owns the phone
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trxId         String   @unique  // bKash transaction ID (e.g. 8N34KJL98S)
  sender        String   // Parsed bKash sender number (customer number)
  amount        Float    // Parsed amount sent
  rawMessage    String   // Raw SMS body
  senderAddress String?  // Raw SMS sender address (e.g. "bKash", "NAGAD", "16216")
  status        String   @default("unused") // "unused", "used"
  orderId       String?  // Optional local WooCommerce order/payment ID
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, sender, amount, status])
}


model ShowcaseCustomer {
  id         String   @id @default(cuid())
  name       String   // Company name
  logoUrl    String   // ImageKit hosted URL
  websiteUrl String?  // Optional customer link
  order      Int      @default(0) // Order priority for sorting
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model CodePayPayment {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Float
  orderId       String
  customerName  String
  customerEmail String
  redirectUrl   String
  status        String   @default("pending") // pending, completed, expired
  method        String?  // bkash, nagad, rocket
  trxId         String?
  senderNumber  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
}

model Invoice {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // "custom" | "license" | "service" | "transaction"
  itemId      String?  // ID of the target License, ServiceRequest, or PaymentTransaction
  title       String
  amount      Float
  paid        Float
  notes       String?
  name        String?
  email       String?
  phone       String?
  currency       String?  @default("BDT")
  preparedBy     String?
  preparedByEmail String?
  paymentDetails String?
  address        String?  // Client multi-line address, company name, EIN/Tax ID
  items          Json?    // [{ description: string, quantity: number, rate: number, amount: number }]
  billingMonth   String?   // "YYYY-MM" — the month this invoice covers (e.g. "2026-08")
  lastEmailedAt  DateTime? // Timestamp of last email sent to client
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId, type])
}
